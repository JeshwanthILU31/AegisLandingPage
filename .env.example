# ==============================================================================
# SERVER-SIDE CONFIGURATION (Render / Node.js Server Environment ONLY)
# Never expose these variables to the frontend or client bundle!
# ==============================================================================
PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
FRONTEND_URL=https://aegisservice.in

# ==============================================================================
# FRONTEND CONFIGURATION (Vercel / Vite Client Environment)
# Injected into the React bundle at build time by Vite.
# ==============================================================================
VITE_API_URL=https://aegis-backend-2sb2.onrender.com
